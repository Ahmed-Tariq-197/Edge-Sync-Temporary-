<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edgesync_bringup</name>
  <version>1.0.0</version>
  <description>Launch, configurations, and FastDDS profiles for EdgeSync</description>
  <maintainer email="edgesync-dev@robotics.org">EdgeSync Team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>edgesync_msgs</exec_depend>
  <exec_depend>edgesync_perception</exec_depend>
  <exec_depend>edgesync_estimation</exec_depend>
  <exec_depend>edgesync_identity</exec_depend>
  <exec_depend>edgesync_coordination</exec_depend>
  <exec_depend>edgesync_navigation</exec_depend>
  <exec_depend>edgesync_acquisition</exec_depend>
  <exec_depend>edgesync_observability</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
